# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/northern_meteor?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# One-time production ADMIN bootstrap (npm run admin:provision)
# Do not commit real values. Do not use demo seed passwords.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=Administrator

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# Storage (local | s3 | cloudinary)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=public/uploads
STORAGE_MAX_FILE_SIZE_MB=5

# Optional remote storage (leave empty for local)
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=

# Rate limiting (requests per window)
RATE_LIMIT_CONTACT_MAX=5
RATE_LIMIT_CONTACT_WINDOW_MS=900000
RATE_LIMIT_QUOTE_MAX=5
RATE_LIMIT_QUOTE_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000

# Notifications / quote attachments (stubs until providers are wired)
NOTIFICATION_PROVIDER=noop
QUOTE_ATTACHMENT_PROVIDER=stub
